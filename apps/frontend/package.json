{
	"name": "frontend",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "next build",
		"check": "biome check .",
		"check:unsafe": "biome check --write --unsafe .",
		"check:write": "biome check --write .",
		"dev": "next dev --turbo",
		"dev-portless": "portless podevents next dev --turbo",
		"format": "biome format --write .",
		"preview": "next build && next start",
		"start": "next start",
		"typecheck": "tsc --noEmit",
		"prepare": "husky"
	},
	"lint-staged": {
		"**/*.{ts,tsx,js,jsx,json,jsonc,css}": [
			"biome check --write --no-errors-on-unmatched"
		]
	},
	"dependencies": {
		"@radix-ui/react-dialog": "^1.1.22",
		"@radix-ui/react-slot": "^1.3.2",
		"@t3-oss/env-nextjs": "^0.12.0",
		"@tanstack/react-query": "^5.101.4",
		"axios": "^1.18.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"framer-motion": "^12.42.2",
		"lint-staged": "^17.2.0",
		"lucide-react": "^1.27.0",
		"next": "^16.2.11",
		"pluralize": "^8.0.0",
		"portless": "^0.15.4",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-query-kit": "^3.3.4",
		"tailwind-merge": "^3.6.0",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.5",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "^26.1.1",
		"@types/pluralize": "^0.0.33",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"husky": "^9.1.7",
		"postcss": "^8.5.23",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3"
	},
	"overrides": {
		"postcss": "8.5.23",
		"sharp": "0.35.0"
	},
	"ct3aMetadata": {
		"initVersion": "7.40.0"
	}
}
